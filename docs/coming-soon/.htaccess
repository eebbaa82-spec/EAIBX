# Coming-soon mode: every address shows coming-soon.html over https.
# To launch the full site, replace this file with the site's own .htaccess.
DirectoryIndex coming-soon.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Let the host's certificate checks through untouched.
  RewriteRule ^\.well-known/ - [L]
  # Send everyone to https://investopia.et (the address the certificate covers).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^investopia\.et$ [NC]
  RewriteRule ^ https://investopia.et/ [R=301,L]
  RewriteCond %{REQUEST_URI} !^/coming-soon\.html$
  RewriteCond %{REQUEST_URI} !^/api/submit\.php$
  RewriteRule ^ /coming-soon.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex"
  Header set Cache-Control "no-cache"
</IfModule>

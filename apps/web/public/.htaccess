# Settings for Apache hosts (cPanel and similar). Ignored by other servers.
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Let the host's certificate checks through untouched.
  RewriteRule ^\.well-known/ - [L]
  # Always use https and the address the certificate covers (investopia.et, no www).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^investopia\.et$ [NC]
  RewriteRule ^ https://investopia.et%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(js|css|woff2|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
